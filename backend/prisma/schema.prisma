generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int                 @id @default(autoincrement())
  username       String              @unique
  passwordHash   String              @map("password_hash")
  fullName       String?             @map("full_name")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  roles          UserRole[]
  attendance     AttendanceSession[]
  phone          String?             @unique
  pinHash        String?             @map("pin_hash") // 4-digit login PIN (bcrypt)
  locationLogs   LocationLog[]
  leaveRequests  LeaveRequest[]      @relation("userLeaves")
  reviewedLeaves LeaveRequest[]      @relation("reviewedLeaves")

  // ---- Employment profile (HRMS master data) ----
  employeeId         String?   @unique @map("employee_id")
  designation        String?
  department         String?
  employmentType     String?   @map("employment_type") // Permanent | Temporary | Intern | Contract | Consultant
  dateOfJoining      DateTime? @map("date_of_joining") @db.Date
  reportingManagerId Int?      @map("reporting_manager_id")
  reportingManager   User?     @relation("reports", fields: [reportingManagerId], references: [id])
  directReports      User[]    @relation("reports")

  // ---- Personal ----
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  bloodGroup       String?   @map("blood_group")
  address          String?
  emergencyContact String?   @map("emergency_contact")

  // ---- Statutory & bank (admin-only visibility) ----
  esiNumber   String? @map("esi_number")
  epfNumber   String? @map("epf_number")
  panNumber   String? @map("pan_number")
  salaryCtc   Float?  @map("salary_ctc")
  bankName    String? @map("bank_name")
  bankAccount String? @map("bank_account")
  bankIfsc    String? @map("bank_ifsc")

  // ---- Exit management ----
  exitDate            DateTime? @map("exit_date") @db.Date
  exitReason          String?   @map("exit_reason") // Resigned | Abscond | Termination
  noticeServed        Boolean?  @map("notice_served")
  exitFormalitiesDone Boolean?  @map("exit_formalities_done")

  corrections         AttendanceCorrection[] @relation("userCorrections")
  reviewedCorrections AttendanceCorrection[] @relation("reviewedCorrections")
  sentMessages        ChatMessage[]          @relation("sentMessages")
  receivedMessages    ChatMessage[]          @relation("receivedMessages")
  createdGroups       ChatGroup[]            @relation("createdGroups")
  groupMemberships    ChatGroupMember[]      @relation("groupMemberships")
  notes               Note[]                 @relation("userNotes")
  authoredNotes       Note[]                 @relation("authoredNotes")
  otRequests          OtRequest[]            @relation("userOt")
  reviewedOt          OtRequest[]            @relation("reviewedOt")
  compOffRequests     CompOffRequest[]       @relation("userCompOff")
  reviewedCompOff     CompOffRequest[]       @relation("reviewedCompOff")

  @@map("users")
}

// Compensation leave (comp-off) — an employee who worked on a week-off (Sunday)
// or a company holiday can request a comp-off CREDIT for that day. Once an
// admin approves it, the credit becomes 1 day of "CO" leave balance, spent
// later through the normal leave-request flow (leave type code "CO").
// The admin review screen shows the punch record of the worked day: a full day
// is 9:30 → 18:30 IST — missing or short punches are flagged so the admin can
// reject, or revoke an already-approved credit (status = "revoked").
model CompOffRequest {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  workDate     DateTime  @map("work_date") @db.Date // the week-off/holiday actually worked
  reason       String? // what work was done that day
  status       String    @default("pending") // pending | approved | rejected | cancelled | revoked
  reviewNote   String?   @map("review_note")
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation("userCompOff", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("reviewedCompOff", fields: [reviewedById], references: [id])

  @@index([userId, workDate])
  @@index([status, workDate])
  @@map("comp_off_requests")
}

// Overtime — an employee requests OT BEFORE doing it (with the planned work as
// the reason). It lands on their OT calendar only once an admin approves it.
// Admins can also add OT directly (source = "admin"): those rows are created
// pre-approved, individually or for a group of employees at once.
model OtRequest {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  date         DateTime  @db.Date
  startTime    DateTime  @map("start_time")
  endTime      DateTime  @map("end_time")
  hours        Float
  reason       String // the work planned/done during the OT
  status       String    @default("pending") // pending | approved | rejected | cancelled
  source       String    @default("employee") // employee | admin
  reviewNote   String?   @map("review_note")
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation("userOt", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("reviewedOt", fields: [reviewedById], references: [id])

  @@index([userId, date])
  @@index([status, date])
  @@map("ot_requests")
}

// Team chat message — either a 1:1 DM (receiverId) or a group post (groupId).
// Exactly one of receiverId/groupId is set (enforced in the route layer).
model ChatMessage {
  id             Int        @id @default(autoincrement())
  senderId       Int        @map("sender_id")
  receiverId     Int?       @map("receiver_id")
  groupId        Int?       @map("group_id")
  body           String
  attachment     String? // uploads/chat/<file> — photo or video shared from gallery
  attachmentType String?    @map("attachment_type") // image | video
  readAt         DateTime?  @map("read_at") // DM read receipt; groups use lastReadId
  createdAt      DateTime   @default(now()) @map("created_at")
  sender         User       @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User?      @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  group          ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([receiverId, readAt])
  @@index([senderId, receiverId, id])
  @@index([groupId, id])
  @@map("chat_messages")
}

model ChatGroup {
  id          Int               @id @default(autoincrement())
  name        String
  createdById Int               @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   User              @relation("createdGroups", fields: [createdById], references: [id])
  members     ChatGroupMember[]
  messages    ChatMessage[]

  @@map("chat_groups")
}

// Membership + per-member read cursor (unread = messages with id > lastReadId).
model ChatGroupMember {
  groupId    Int       @map("group_id")
  userId     Int       @map("user_id")
  lastReadId Int       @default(0) @map("last_read_id")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  group      ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User      @relation("groupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("chat_group_members")
}

// Employee-raised attendance correction (missed punch in/out) awaiting admin review.
model AttendanceCorrection {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  date         DateTime  @db.Date
  requestedIn  DateTime? @map("requested_in")
  requestedOut DateTime? @map("requested_out")
  reason       String
  status       String    @default("pending") // pending | approved | rejected | cancelled
  reviewNote   String?   @map("review_note")
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation("userCorrections", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("reviewedCorrections", fields: [reviewedById], references: [id])

  @@index([userId, date])
  @@map("attendance_corrections")
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AttendanceSession {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  punchInTime     DateTime  @map("punch_in_time")
  punchOutTime    DateTime? @map("punch_out_time")
  punchInLat      Float?    @map("punch_in_lat")
  punchInLng      Float?    @map("punch_in_lng")
  punchInAcc      Float?    @map("punch_in_acc")
  punchOutLat     Float?    @map("punch_out_lat")
  punchOutLng     Float?    @map("punch_out_lng")
  punchOutAcc     Float?    @map("punch_out_acc")
  workingHours    Float?    @map("working_hours")
  isLate          Boolean   @default(false) @map("is_late")
  user            User      @relation(fields: [userId], references: [id])
  punchInPhoto    String?   @map("punch_in_photo")
  punchOutPhoto   String?   @map("punch_out_photo")
  punchInAddress  String?   @map("punch_in_address")
  punchOutAddress String?   @map("punch_out_address")
  siteName        String?   @default("SESS") @map("site_name")

  @@index([userId, punchInTime])
  @@map("attendance_session")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}

model Site {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  lat       Float
  lng       Float
  radiusM   Int      @default(100) @map("radius_m")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sites")
}

model LeaveType {
  id       Int            @id @default(autoincrement())
  code     String         @unique // CL, SL, PL
  name     String
  active   Boolean        @default(true)
  policies LeavePolicy[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model LeavePolicy {
  id          Int       @id @default(autoincrement())
  year        Int
  leaveTypeId Int       @map("leave_type_id")
  quota       Float // days allocated for the year
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([year, leaveTypeId])
  @@map("leave_policies")
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  leaveTypeId  Int       @map("leave_type_id")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  halfDay      Boolean   @default(false) @map("half_day")
  days         Float
  reason       String?
  status       String    @default("pending") // pending | approved | rejected | cancelled
  appliedAt    DateTime  @default(now()) @map("applied_at")
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?   @map("review_note")
  user         User      @relation("userLeaves", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("reviewedLeaves", fields: [reviewedById], references: [id])
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([userId, startDate])
  @@map("leave_requests")
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

model LocationLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  lat        Float
  lng        Float
  acc        Float?
  address    String?
  capturedAt DateTime @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, capturedAt])
  @@map("location_log")
}

// Notes — one row per note belonging to exactly ONE employee (userId).
//  kind = "self"  : the employee's own private note (they can edit/delete it)
//  kind = "admin" : a one-way notice an admin sent to that employee. Read-only
//                   for the employee — there is no reply path anywhere.
// Nobody but the owner (and the admin who wrote an "admin" note) can read it.
model Note {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id") // owner / recipient
  authorId  Int?      @map("author_id") // writer: self, or the sending admin
  kind      String    @default("self") // self | admin
  body      String
  photo     String? // uploads/notes/<file> — optional photo on a self note
  readAt    DateTime? @map("read_at") // admin notices only — powers the badge
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation("userNotes", fields: [userId], references: [id], onDelete: Cascade)
  author    User?     @relation("authoredNotes", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([userId, id])
  @@index([authorId, id])
  @@map("notes")
}
